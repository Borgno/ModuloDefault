# Porta do navegador: Vite em dev, Hono (front + API) em produção.
PORT=3000

# Porta da API em dev, atrás do proxy do Vite.
API_PORT=3001

# Obrigatória. Assina o cookie de sessão (32+ caracteres): openssl rand -base64 48
SESSION_SECRET=

# Obrigatória. Senha de admin@local.test e user@local.test, recriados a cada start.
SEED_PASSWORD=

# Par VAPID do Web Push, próprio de cada deploy: bunx web-push generate-vapid-keys. Obrigatório em
# produção; em dev, sem ele, um par novo é gerado a cada start e as inscrições se refazem.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: ou a URL https:// do sistema.
VAPID_SUBJECT=mailto:notificacoes@localhost
