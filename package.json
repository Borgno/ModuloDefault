{
  "name": "default",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "concurrently -k -n FRONT,BACK -c cyan,magenta \"bun run dev:api\" \"sleep 1 &&bun run dev:ui\"",
    "dev:ui": "react-router dev",
    "dev:api": "tsx watch server/index.ts",
    "build": "react-router build && bun run build:api",
    "build:api": "esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=build/api/index.js",
    "start": "NODE_ENV=production node build/api/index.js",
    "typecheck": "react-router typegen && tsc",
    "typecheck:api": "tsc -p tsconfig.server.json",
    "lint": "eslint .",
    "lint:api": "tsx server/scripts/dumpOpenApi.ts && bunx @stoplight/spectral-cli@6.16.3 lint build/openapi.json --ruleset .spectral.yaml --fail-severity=warn",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.6.3",
    "hono": "^4.13.8",
    "isbot": "^5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@playwright/test": "^1.63.0",
    "@react-router/dev": "^8.4.0",
    "@react-router/node": "^8.4.0",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-query": "^5.103.2",
    "@types/node": "^22",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.3.2",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "lucide-react": "^1.47.0",
    "prettier": "^3.9.8",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.88.0",
    "react-router": "^8.4.0",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.0.3",
    "vitest": "^5.0.1"
  }
}
