{
  "include": ["server/**/*"],
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"],
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true
  }
}
